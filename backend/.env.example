PORT=3000

# Banco (o host "mysql" é o serviço do docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=a8

# Troque por um segredo próprio
JWT_SECRET=troque_por_um_segredo
JWT_EXPIRES_IN=7d

# Kafka
KAFKA_ATIVO=true
# Jetson (só alcançável de dentro da rede do Dcomp)
KAFKA_BROKER=172.18.4.56:9092
# Nuvem (antigo): 34.66.235.91:9093
KAFKA_TOPICO=ods.i7.plate_read
KAFKA_GROUP_ID=A8-acesso
# false = só mensagens novas; true = relê o tópico desde o início
KAFKA_DESDE_O_INICIO=false
