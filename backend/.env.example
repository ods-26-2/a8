PORT=3000

# Banco (o host "mysql" é o serviço do docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=a8

# Troque por um segredo próprio
JWT_SECRET=troque_por_um_segredo
JWT_EXPIRES_IN=7d

# Kafka
KAFKA_ATIVO=true
# Broker da Jetson. Escolha UMA linha:
# Fora do Dcomp (nuvem, casa): endereço público
KAFKA_BROKER=200.17.66.56:9092
# Dentro da rede do Dcomp: endereço privado (com KAFKA_ALVO igual na ponte e docker-compose.rede.yml)
# KAFKA_BROKER=172.18.4.56:9092
# Enquanto o broker anunciar localhost:9092, suba com docker-compose.ponte.yml (ver docs/kafka.md, 1.4)
KAFKA_TOPICO=ods.i7.plate_read
KAFKA_GROUP_ID=A8-acesso
# false = só mensagens novas; true = relê o tópico desde o início
KAFKA_DESDE_O_INICIO=false